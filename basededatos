CREATE DATABASE LigaFutbol;
USE LigaFutbol;

-- =====================================
-- TORNEOS
-- =====================================

CREATE TABLE Torneos(
id_torneo INT AUTO_INCREMENT PRIMARY KEY,
nombre VARCHAR(100) NOT NULL,
temporada VARCHAR(50) NOT NULL
);

-- =====================================
-- ARBITROS
-- =====================================

CREATE TABLE Arbitros(
id_arbitro INT AUTO_INCREMENT PRIMARY KEY,
nombre VARCHAR(100) NOT NULL,
edad INT,
tarjetasMostradas INT DEFAULT 0,
partidosArbitrados INT DEFAULT 0
);

-- =====================================
-- EQUIPOS
-- =====================================

CREATE TABLE Equipos(
id_equipo INT AUTO_INCREMENT PRIMARY KEY,
nombre VARCHAR(100) NOT NULL,
puntos INT DEFAULT 0,
golesfavor INT DEFAULT 0,
golescontra INT DEFAULT 0,
partidosjugados INT DEFAULT 0,
ganados INT DEFAULT 0,
empatados INT DEFAULT 0,
perdidos INT DEFAULT 0
);

-- =====================================
-- JUGADORES
-- =====================================

CREATE TABLE Jugadores(
id_jugador INT AUTO_INCREMENT PRIMARY KEY,
nombre VARCHAR(100) NOT NULL,
posicion VARCHAR(50),
dorsal INT,
goles INT DEFAULT 0,
tarjetas_amarillas INT DEFAULT 0,
tarjetas_rojas INT DEFAULT 0,

```
id_equipofk INT NOT NULL,

CONSTRAINT fk_jugador_equipo
FOREIGN KEY(id_equipofk)
REFERENCES Equipos(id_equipo)
```

);

-- =====================================
-- TIPO
-- =====================================

CREATE TABLE Tipo(
id_tipo CHAR(1) PRIMARY KEY,

```
CHECK(id_tipo IN ('L','V'))
```

);

-- =====================================
-- PARTIDO
-- =====================================

CREATE TABLE Partido(
id_partido INT AUTO_INCREMENT PRIMARY KEY,
fecha DATE NOT NULL,
goles_local INT DEFAULT 0,
goles_visitante INT DEFAULT 0,

```
id_torneofk INT NOT NULL,
id_arbitrofk INT NOT NULL,
id_tipofk CHAR(1) NOT NULL,
id_equipofk INT NOT NULL,

CONSTRAINT fk_partido_torneo
FOREIGN KEY(id_torneofk)
REFERENCES Torneos(id_torneo),

CONSTRAINT fk_partido_arbitro
FOREIGN KEY(id_arbitrofk)
REFERENCES Arbitros(id_arbitro),

CONSTRAINT fk_partido_tipo
FOREIGN KEY(id_tipofk)
REFERENCES Tipo(id_tipo),

CONSTRAINT fk_partido_equipo
FOREIGN KEY(id_equipofk)
REFERENCES Equipos(id_equipo)
```

);
