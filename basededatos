-----pruebas----
----sonselect simples para verficar que los datos funcionan bien y las tablas pueden conectarse entre si-----
--mostrar torneos---
SELECT * FROM Torneos;
---mostrar la clasificacion de los equipos por puntos---
SELECT nombre, puntos
FROM Equipos
ORDER BY puntos DESC;
---mostrar los partidos en que torneo se juega y el albitro de ese partido---
SELECT
p.id_partido,
p.fecha,
t.nombre AS torneo,
a.nombre AS arbitro
FROM Partido p
JOIN Torneos t ON p.id_torneofk = t.id_torneo
JOIN Arbitros a ON p.id_arbitrofk = a.id_arbitro;
--mostrar resultados---
SELECT
fecha,
goles_local,
goles_visitante
FROM Partido;
---mostrar clasificacion con puntos y ver cuantas victorias,derrotas y empates tiene cada uno----
SELECT
nombre,
puntos,
ganados,
empatados,
perdidos
FROM Equipos
ORDER BY puntos DESC;
